{
  "name": "read_file",
  "description": "Reads a text file, numbered lines at a time.",
  "parameters": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "the file's path"
      },
      "from": {
        "type": "integer",
        "description": "the first line (1 by default)"
      },
      "lines": {
        "type": "integer",
        "description": "how many lines (200 by default)"
      }
    },
    "required": [
      "path"
    ]
  },
  "run": {
    "kind": "python",
    "entry": "run.py",
    "timeout_ms": 60000
  }
}
